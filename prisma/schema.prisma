generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
 
}

// USER TABLE
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  collegeId String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  listings  Listing[]
  orders    Order[]
  cart      Cart[]
  favorites Favorite[]
}

enum Role {
  STUDENT
  ADMIN
}

// CATEGORY TABLE
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  listings  Listing[]
}

// LISTING TABLE
model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  image       String?
  contact     String
  status      Status   @default(AVAILABLE)
  createdAt   DateTime @default(now())

  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String

  seller      User     @relation(fields: [sellerId], references: [id])
  sellerId    String

  orders      Order[]
  cart        Cart[]
  favorites Favorite[]
}
enum Status {
  AVAILABLE
  SOLD
}
// FAVORITES TABLE
model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  createdAt DateTime @default(now())
}
// CART TABLE
model Cart {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  createdAt DateTime @default(now())
}

// ORDER TABLE
model Order {
  id              String   @id @default(cuid())
  buyer           User     @relation(fields: [buyerId], references: [id])
  buyerId         String
  listing         Listing  @relation(fields: [listingId], references: [id])
  listingId       String
  amount          Float
  paymentId       String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}